{
  "name": "you-want-download",
  "productName": "You Want Download",
  "version": "0.1.0",
  "description": "A free, open-source Windows download manager",
  "main": "app/main.cjs",
  "author": "You Want Download contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kavianpcx/You-Want-Download.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check app/engine.cjs && node --check app/main.cjs && node --check app/preload.cjs && node --check ui/app.js",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "com.youwantdownload.desktop",
    "productName": "You Want Download",
    "asar": {
      "contentAlignment": 512
    },
    "files": [
      "app/**/*",
      "ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "You-Want-Download-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "differentialPackage": "store-asar"
    },
    "portable": {
      "artifactName": "You-Want-Download-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kavianpcx",
        "repo": "You-Want-Download"
      }
    ]
  }
}
